generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  password     String
  roles        Role[]    @default([USER])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  courses_keys String[]
  devices      Device[]
  sessions     Session[]
}

model Device {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String
  refreshToken String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

model Course {
  id        String   @id @default(cuid())
  title     String   @unique
  author    String
  price     Int
  image     String
  isPublic  Boolean  @default(false)
  description String
  pricePlans  Json        @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lessons   Lesson[]
  comments  Comment[]
  dictionaries Dictionary[]
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  description String
  level     String
  duration  String
  video     String
  words     String[]
  isPublic  Boolean  @default(false)
  courseId  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  course    Course   @relation(fields: [courseId], references: [id])
  dictionaries Dictionary[]
}

model Comment {
    id        String   @id @default(cuid())
    comment   String
    userId    String
    courseId  String
    course    Course   @relation(fields: [courseId], references: [id])
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
}

model DictionaryCategory {
    id        String   @id @default(cuid())
    name      String
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
}

model Dictionary {
    id                   String   @id @default(cuid())
    categoryId           String
    courseId             String?  
    lessonId             String?  
    word_uz              String
    word_en              String
    word_chinese         String
    example_uz           String
    example_en           String
    example_chinese      String
    pronunciation        String
    example_pronunciation String
    createdAt            DateTime @default(now()) @map("created_at")
    updatedAt            DateTime @updatedAt @map("updated_at")

    course    Course?   @relation(fields: [courseId], references: [id])
    lesson    Lesson?   @relation(fields: [lessonId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum PlanDuration {
  MONTH_1
  MONTH_3
  MONTH_6
  MONTH_12
  FOREVER
}